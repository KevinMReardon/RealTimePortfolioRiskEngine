OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic Agent Briefing (Phase 1) ---
AGENT_BRIEFING_ENABLED=false
AGENT_BRIEFING_SCHEDULER_ENABLED=false
AGENT_BRIEFING_CRON=0 13 * * 1-5
AGENT_BRIEFING_COOLDOWN_MINUTES=30
AGENT_BRIEFING_TZ=America/New_York
ANTHROPIC_API_KEY=
# Optional override for Anthropic-compatible gateway/proxy.
ANTHROPIC_BASE_URL=
AGENT_MODEL=claude-sonnet-4.6
AGENT_MAX_TOKENS=2048
AGENT_TEMPERATURE=0.2
AGENT_MAX_TOOL_CALLS=12
AGENT_MAX_TURNS=8
AGENT_SESSION_TIMEOUT_SECONDS=120

# --- Phase 3 agent execution (orchestration wiring comes later) ---
# Exact strings: off (default) | paper_auto
# If POLICY_MODE=monitor, paper_auto is forced off at load (autonomous submit unsafe in monitor mode).
AGENT_EXEC_MODE=off
# Optional critic model for a future review pass (empty = default when wired).
# AGENT_CRITIC_MODEL=
# One autonomous paper pipeline attempt; min 10s, default 300s.
# AGENT_PAPER_AUTO_TIMEOUT_SECONDS=300
# Max broker submits per agent session; min 1, default 5.
# AGENT_MAX_AUTO_SUBMITS_PER_SESSION=5
# How often to retry missing NY-day equity anchors for Alpaca sync targets; min 1, default 15.
# EQUITY_ANCHOR_ENSURE_INTERVAL_MINUTES=15

# --- Policy (proposals / risk engine) ---
# enforce (default) | monitor — monitor relaxes effective ALLOW on violations; do not pair with AGENT_EXEC_MODE=paper_auto.
# POLICY_MODE=enforce

PROMETHEUS_ENABLED=false
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/portfolio?sslmode=disable

# Single-operator mode defaults to true; omit unless you want multi-portfolio catalog creation.
# SINGLE_USER_APP=false

# Automated price feed configuration
# Docs: docs/implementation/automated_price_feed_ingestion_282b9a66.plan.md (Slice 1)
PRICE_FEED_ENABLED=false
# Price polling provider: twelvedata | alpaca (Market Data REST latest trades — not streaming).
PRICE_FEED_PROVIDER=twelvedata
# Symbols should use internal format accepted by PricePayload (e.g. EUR-USD).
PRICE_FEED_SYMBOLS=AAPL,MSFT,BTC-USD,ETH-USD,EUR-USD
PRICE_FEED_POLL_SECONDS=900
PRICE_FEED_HTTP_TIMEOUT_MS=5000
PRICE_FEED_RETRY_COUNT=3
PRICE_FEED_RETRY_DELAY_MS=500

# Feed quality guards
# Reject upstream quotes whose as-of time is older than this (0 disables).
PRICE_FEED_MAX_QUOTE_AGE_MS=1800000
# Skip unchanged prices within this window to reduce write churn (0 disables).
PRICE_FEED_DEDUP_WINDOW_MS=60000

# Twelve Data credentials
PRICE_FEED_TWELVEDATA_API_KEY=

# Twelve Data request cap (requests per minute)
# Loader safety will raise poll interval if needed so:
# len(PRICE_FEED_SYMBOLS) * 60 / PRICE_FEED_POLL_SECONDS <= PRICE_FEED_TWELVEDATA_RATE_LIMIT_RPM
PRICE_FEED_TWELVEDATA_RATE_LIMIT_RPM=8

# When PRICE_FEED_PROVIDER=alpaca: assumed HTTP calls per poll ≈ (# equity symbols) + 1 crypto batch.
# Loader raises PRICE_FEED_POLL_SECONDS so symbol_count*60/poll_seconds does not exceed this RPM.
PRICE_FEED_ALPACA_RATE_LIMIT_RPM=200

# --- Alpaca ---
# Portfolio/account coupling is DB-backed:
# portfolios.portfolio_id -> alpaca_account_mode + alpaca_sync_enabled + alpaca_key_id/secret/base_url + cursor.
# Sync workers use portfolio-scoped credentials stored in the catalog rows (not global env creds).
# These optional env credentials are only used by import/backfill helpers when present.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

ALPACA_LIVE_KEY_ID=
ALPACA_LIVE_SECRET_KEY=
ALPACA_LIVE_BASE_URL=https://api.alpaca.markets

# Backward-compatible fallback (treated as paper when ALPACA_PAPER_* are unset):
# ALPACA_KEY_ID=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Background fill sync (cmd/server goroutine): polls Alpaca for new FILL activities → TradeExecuted events.
# ALPACA_SYNC_ENABLED:
#   Defaults to true when omitted. Sync runs when mode credentials are set and at least one
#   portfolio row has alpaca_sync_enabled=true.
#   false / 0 / no / off → disable the polling worker while keeping keys (e.g. for HTTP import jobs).
ALPACA_SYNC_INTERVAL_SECONDS=90
ALPACA_SYNC_HISTORY_DAYS=365

# Market Data REST origin (latest trades used when PRICE_FEED_PROVIDER=alpaca). Separate from trading REST.
# Defaults to https://data.alpaca.markets when unset.
# ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Market data WebSocket (separate URL from REST); optional stream wiring in internal/connectors/alpaca (see StreamConfigFromREST).
# ALPACA_DATA_STREAM_BASE_URL=https://stream.data.alpaca.markets/v2
# ALPACA_DATA_FEED=iex

# Async history import jobs (cmd/server): ALPACA_IMPORT_JOB_POLL_SECONDS=2
# ALPACA_IMPORT_JOB_TIMEOUT_SECONDS=7200

